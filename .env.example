# Copy this file to .env and put your real key in .env.
# .env is in .gitignore. Never commit it.
ANTHROPIC_API_KEY=

# Models. Check IDs and prices in the Anthropic docs before changing them.
EXTRACT_MODEL=claude-haiku-5-5
LABEL_MODEL=claude-sonnet-5-5
AGENT_MODEL=claude-sonnet-5-5
CRITIC_MODEL=claude-opus-5-5

# Most one agent run may spend, in US dollars.
MAX_COST_PER_RUN=2.00
